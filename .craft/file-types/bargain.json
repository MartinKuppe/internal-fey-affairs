{
  "fileTypeId": "019fed62-5e98-7d8c-921a-555feedb41ac",
  "slug": "bargain",
  "name": "Bargain",
  "contentType": "json",
  "designation": null,
  "category": null,
  "schemaHash": "944593c2-f612-f3aa-856d-69e811dd98ee",
  "schema": {
    "type": "object",
    "required": [
      "name",
      "parties"
    ],
    "properties": {
      "kind": {
        "enum": [
          "grace-trade",
          "settlement",
          "contract",
          "indenture",
          "standard-agreement",
          "investigation"
        ],
        "type": "string",
        "title": "Kind",
        "default": "contract"
      },
      "name": {
        "type": "string",
        "title": "Name",
        "minLength": 1
      },
      "image": {
        "type": "object",
        "title": "Image",
        "format": "image",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "focalPoint": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              },
              "y": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              }
            }
          },
          "generation": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "generating",
                  "success",
                  "error"
                ],
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "finishedAt": {
                "type": "string"
              }
            }
          },
          "overlayUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "notes": {
        "type": "string",
        "title": "Notes",
        "format": "textarea"
      },
      "status": {
        "enum": [
          "active",
          "resolved",
          "breached",
          "void"
        ],
        "type": "string",
        "title": "Status",
        "default": "active"
      },
      "parties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "label",
            "obligations"
          ],
          "properties": {
            "refs": {
              "type": "array",
              "items": {
                "type": "string",
                "reference": {
                  "targets": [
                    {
                      "fileTypeSlug": "player-character"
                    },
                    {
                      "fileTypeSlug": "non-player-character"
                    }
                  ]
                }
              },
              "title": "Linked characters"
            },
            "role": {
              "type": "string",
              "title": "Role"
            },
            "label": {
              "type": "string",
              "title": "Party",
              "minLength": 1
            },
            "obligations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "wording"
                ],
                "properties": {
                  "wording": {
                    "type": "string",
                    "title": "Exact obligation wording",
                    "format": "textarea",
                    "minLength": 1
                  },
                  "resolved": {
                    "type": "boolean",
                    "title": "Resolved",
                    "default": false
                  },
                  "resolvedOn": {
                    "type": "number",
                    "title": "Resolved (day)",
                    "minimum": 1
                  },
                  "dueCondition": {
                    "type": "string",
                    "title": "Due when"
                  },
                  "referenceContract": {
                    "type": "string",
                    "title": "Reference contract",
                    "description": "The specific Bargain contract this obligation falls under, when it is a different document (optional).",
                    "referencedFileTypeSlug": "bargain"
                  }
                }
              },
              "title": "Obligations",
              "minItems": 1,
              "description": "The individual promises or duties carried by this party. Resolve each independently; the party is finished only when every applicable obligation is resolved."
            }
          }
        },
        "title": "Parties",
        "minItems": 2
      },
      "wording": {
        "type": "string"
      },
      "signedOn": {
        "type": "number",
        "title": "Signed (day)",
        "minimum": 1
      },
      "description": {
        "type": "string",
        "title": "Description",
        "format": "textarea"
      },
      "relatedBargains": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "bargain"
        },
        "title": "Related Bargains"
      }
    }
  },
  "layout": {
    "root": "page",
    "elements": {
      "body": {
        "type": "Card",
        "props": {},
        "children": [
          "body-stack"
        ]
      },
      "card": {
        "type": "Card",
        "props": {
          "title": null,
          "bgColor": null,
          "bgImage": null,
          "rounded": null,
          "centered": false,
          "maxWidth": "full",
          "className": null,
          "bgImageFit": null,
          "borderColor": null,
          "description": null
        },
        "children": [
          "wording-text-2"
        ]
      },
      "page": {
        "type": "Stack",
        "props": {
          "gap": "none",
          "direction": "vertical"
        },
        "children": [
          "image-header",
          "body"
        ]
      },
      "sep0": {
        "type": "Separator",
        "props": {},
        "children": []
      },
      "sep1": {
        "type": "Separator",
        "props": {},
        "children": []
      },
      "due-row": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "horizontal"
        },
        "visible": {
          "$item": "dueCondition"
        },
        "children": [
          "due-label",
          "due-text"
        ]
      },
      "due-text": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "dueCondition"
          },
          "variant": "muted"
        },
        "children": []
      },
      "due-label": {
        "type": "Text",
        "props": {
          "text": "Due when:",
          "variant": "muted"
        },
        "children": []
      },
      "role-text": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "role"
          },
          "variant": "caption"
        },
        "visible": {
          "$item": "role"
        },
        "children": []
      },
      "body-stack": {
        "type": "Stack",
        "props": {
          "gap": "md",
          "direction": "vertical"
        },
        "children": [
          "meta-stats",
          "sep0",
          "wording-heading",
          "card",
          "parties-heading",
          "parties-list",
          "sep1",
          "notes-section",
          "related-section",
          "wording-section"
        ]
      },
      "meta-stats": {
        "type": "StatGrid",
        "props": {
          "cols": 3,
          "items": [
            [
              "Kind",
              {
                "$state": "/kind"
              }
            ],
            [
              "Status",
              {
                "$state": "/status"
              }
            ],
            [
              "Signed (day)",
              {
                "$state": "/signedOn"
              }
            ]
          ]
        },
        "children": []
      },
      "notes-text": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/notes"
          }
        },
        "children": []
      },
      "party-card": {
        "type": "Card",
        "props": {
          "title": {
            "$item": "label"
          }
        },
        "children": [
          "party-stack"
        ]
      },
      "party-stack": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "children": [
          "role-text",
          "obligations-table"
        ]
      },
      "image-header": {
        "type": "ImageHeader",
        "props": {
          "src": "https://media.craftrpgs.com/containers/019fde04-44fd-75c8-8f5e-d680c880596d/images/32c50f70-083f-4cd5-a75c-1fc4df1d9657",
          "title": {
            "$state": "/title"
          },
          "subtitle": null,
          "className": null,
          "aspectRatio": "ultrawide"
        },
        "children": []
      },
      "parties-list": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "align": "stretch",
          "direction": "vertical"
        },
        "repeat": {
          "statePath": "/parties"
        },
        "children": [
          "party-card"
        ]
      },
      "resolved-row": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "align": "center",
          "direction": "horizontal"
        },
        "children": [
          "resolved-toggle",
          "resolved-on-row"
        ]
      },
      "wording-text": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "wording"
          },
          "variant": "body"
        },
        "children": []
      },
      "notes-heading": {
        "type": "Heading",
        "props": {
          "text": "Notes",
          "level": "h3"
        },
        "children": []
      },
      "notes-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "visible": {
          "$state": "/notes"
        },
        "children": [
          "notes-heading",
          "notes-text"
        ]
      },
      "related-badges": {
        "type": "BadgeList",
        "props": {
          "items": {
            "$state": "/relatedBargains"
          },
          "variant": "secondary",
          "fileTypeSlug": "bargain"
        },
        "children": []
      },
      "wording-text-2": {
        "type": "Markdown",
        "props": {
          "color": null,
          "content": {
            "$state": "/wording"
          }
        },
        "children": []
      },
      "parties-heading": {
        "type": "Heading",
        "props": {
          "text": "Parties & Obligations",
          "level": "h3"
        },
        "children": []
      },
      "related-heading": {
        "type": "Heading",
        "props": {
          "text": "Related Bargains",
          "level": "h3"
        },
        "children": []
      },
      "related-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "children": [
          "related-heading",
          "related-badges"
        ]
      },
      "resolved-on-row": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "horizontal"
        },
        "visible": {
          "$item": "resolvedOn"
        },
        "children": [
          "resolved-on-label",
          "resolved-on-value"
        ]
      },
      "resolved-toggle": {
        "type": "Toggle",
        "props": {
          "label": "Resolved",
          "value": {
            "$item": "resolved"
          },
          "variant": "switch"
        },
        "children": []
      },
      "wording-heading": {
        "type": "Heading",
        "props": {
          "text": "Wording",
          "level": "h3"
        },
        "children": []
      },
      "wording-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "visible": {
          "$state": "/wording"
        },
        "children": []
      },
      "obligations-table": {
        "type": "DataTable",
        "props": {
          "items": {
            "$item": "obligations"
          },
          "columns": [
            {
              "field": "wording",
              "label": "Exact terms"
            },
            {
              "field": "dueCondition",
              "label": "Due when"
            },
            {
              "field": "resolved",
              "label": "Resolved"
            },
            {
              "field": "resolvedOn",
              "label": "Resolved (day)"
            }
          ],
          "emptyText": "No obligations recorded."
        },
        "children": []
      },
      "resolved-on-label": {
        "type": "Text",
        "props": {
          "text": "on day",
          "variant": "muted"
        },
        "children": []
      },
      "resolved-on-value": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "resolvedOn"
          },
          "variant": "muted"
        },
        "children": []
      }
    }
  },
  "imageStyleInstructions": null,
  "showCoverImage": true,
  "creationFlow": null
}
