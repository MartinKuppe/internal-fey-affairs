          },
          "value": {
            "$item": "current"
          },
          "showValue": true
        },
        "visible": {
          "$and": [
            {
              "$or": [
                {
                  "$item": "showAtZero"
                },
                {
                  "gt": 0,
                  "$item": "current"
                }
              ]
            },
            {
              "gt": 1,
              "$item": "target"
            }
          ]
        },
        "children": []
