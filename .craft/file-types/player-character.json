        "children": []
      },
      "origin-row": {
        "type": "Select",
        "props": {
          "label": "Origin",
          "value": {
            "$state": "/origin"
          },
          "fileTypeSlug": "origin"
        },
        "children": []
      },
      "outfit-row": {
        "type": "Select",
        "props": {
          "label": "Outfit",
          "value": {
            "$state": "/outfit"
          },
          "fileTypeSlug": "outfit"
        },
        "children": []
      },
      "species-row": {
        "type": "Select",
        "props": {
          "label": "Species",
          "value": {
            "$state": "/species"
          },
          "fileTypeSlug": "species"
        },
        "children": []
      },
      "condition-row": {
        "type": "Dots",
        "props": {
          "max": {
            "$item": "maximum"
          },
          "label": {
            "$item": "name"
          },
          "value": {
            "$item": "current"
          }
        },
        "children": []
      },
      "grace-section": {
        "type": "Card",
        "props": {
          "title": "Grace Ledger"
        },
        "children": [
          "grace-refs"
        ]
      },
      "markers-table": {
        "type": "DataTable",
        "props": {
          "items": {
            "$state": "/markers"
          },
          "columns": [
            {
              "field": "marker",
              "label": "Marker"
            },
            {
              "field": "reason",
              "label": "Reason"
            }
          ]
        },
        "children": []
      },
      "abilities-refs": {
        "type": "FileReferenceGrid",
        "props": {
          "size": "md",
          "items": {
            "$state": "/abilities"
          },
          "label": "Trained Abilities",
          "columns": 4,
          "fileTypeSlug": "ability",
          "referenceField": null
        },
        "children": []
      },
      "archetypes-refs": {
        "type": "FileReferenceGrid",
        "props": {
          "size": "md",
          "items": {
            "$state": "/archetypes"
          },
          "label": "Archetypes",
          "columns": 4,
          "fileTypeSlug": "archetype",
          "referenceField": null
        },
        "children": []
      },
      "conditions-list": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "repeat": {
          "key": "key",
          "statePath": "/conditionTracks"
        },
        "children": [
          "condition-row"
        ]
      },
      "markers-section": {
        "type": "Card",
        "props": {
          "title": "Reputation Markers"
        },
        "children": [
          "markers-table"
        ]
      },
      "attributes-stats": {
        "type": "StatGrid",
        "props": {
          "cols": 2,
          "items": [
            [
              "Body",
