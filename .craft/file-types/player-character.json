          "level": "h2"
        },
        "children": []
      },
      "page": {
        "type": "Stack",
        "props": {
          "gap": "md",
          "direction": "vertical"
        },
        "children": [
          "name",
          "divider",
          "origin-row",
          "outfit-row",
          "attributes-section",
          "abilities-section",
          "conditions-section",
          "grace-section",
          "markers-section",
          "species-row",
          "archetypes-section"
