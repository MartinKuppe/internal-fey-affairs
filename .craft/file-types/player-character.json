                "$state": "/attributes/body"
              }
            ],
            [
              "Eyes",
              {
                "$state": "/attributes/eyes"
              }
            ],
            [
              "Head",
              {
                "$state": "/attributes/head"
              }
            ],
            [
              "Heart",
              {
