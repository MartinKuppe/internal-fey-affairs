{
  "fileTypeId": "01a04a10-df1d-7f34-81b9-9ececfa83343",
  "slug": "player-character",
  "name": "Player Character",
  "contentType": "json",
  "designation": "character",
  "category": null,
  "schemaHash": "1a1ebbbf-e0f8-dc18-ea61-0ecab99c97a8",
  "schema": {
    "type": "object",
    "required": [
      "name",
      "outfit"
    ],
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "minLength": 1
      },
      "image": {
        "type": "object",
        "title": "Image",
        "format": "image",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "focalPoint": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              },
              "y": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              }
            }
          },
          "generation": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "generating",
                  "success",
                  "error"
                ],
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "finishedAt": {
                "type": "string"
              }
            }
          },
          "overlayUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "origin": {
        "type": "string",
        "title": "Origin",
        "description": "The protagonist's origin — their starting attribute and three trained abilities.",
        "referencedFileTypeSlug": "origin"
      },
      "outfit": {
        "type": "string",
        "title": "Outfit",
        "description": "The protagonist's current worn outfit.",
        "referencedFileTypeSlug": "outfit"
      },
      "markers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "marker",
            "reason"
          ],
          "properties": {
            "marker": {
              "enum": [
                "Ungrateful",
                "Disrespectful",
                "Unsightly",
                "Violent",
                "Cruel",
                "Untrustworthy",
                "Oath-Breaker",
                "Generous",
                "Respectful",
                "Handsome",
                "Elegant",
                "Merciful",
                "Trustworthy",
                "Oath-Keeper"
              ],
              "type": "string",
              "title": "Marker"
            },
            "reason": {
              "type": "string",
              "title": "Reason"
            }
          }
        },
        "title": "Reputation Markers",
        "description": "Markers are visible to everyone — simply present or absent, each with the reason it was acquired."
      },
      "species": {
        "type": "string",
        "title": "Species",
        "description": "This character's species — Human or Fey in ordinary project metadata. Optional player-character classification.",
        "referencedFileTypeSlug": "species"
      },
      "abilities": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "ability"
        },
        "title": "Trained Abilities",
        "description": "Start with the origin's three abilities. The GM may award additional abilities during play."
      },
      "archetypes": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "archetype"
        },
        "title": "Archetypes",
        "description": "Every applicable archetype — provenance, pattern, fey-role, profession, title, or social identity. Stored explicitly and flat; never inferred from indirect chains."
      },
      "attributes": {
        "type": "object",
        "title": "Attribute Dice",
        "properties": {
          "body": {
            "type": "number",
            "title": "Body",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "eyes": {
            "type": "number",
            "title": "Eyes",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "head": {
            "type": "number",
            "title": "Head",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "legs": {
            "type": "number",
            "title": "Legs",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "hands": {
            "type": "number",
            "title": "Hands",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "heart": {
            "type": "number",
            "title": "Heart",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "shadow": {
            "type": "number",
            "title": "Shadow",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          }
        },
        "description": "Each attribute is a dice pool of 1-5 d6s; every 4+ is a success. The protagonist's origin attribute starts at 3, the rest at 2."
      },
      "description": {
        "type": "string",
        "title": "Description",
        "format": "textarea"
      },
      "graceLedger": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "currency",
            "amount",
            "day",
            "reason"
          ],
          "properties": {
            "day": {
              "type": "number",
              "title": "Day",
              "minimum": 1
            },
            "amount": {
              "type": "number",
              "title": "Amount",
              "description": "Signed balance change: positive credits the character, negative debits the character."
            },
            "reason": {
              "type": "string",
              "title": "Exact reason",
              "description": "Explains whether this entry was a payment, an exchange, a penalty, or a debt."
            },
            "currency": {
              "type": "string",
              "title": "Currency",
              "referencedFileTypeSlug": "grace"
            }
          }
        },
        "title": "Grace Ledger",
        "description": "Authoritative record of every Grace gain or loss. Balances are derived from this ledger — never maintain a separate running total. Negative amounts are Grace debt."
      },
      "conditionState": {
        "type": "object",
        "title": "Condition State",
        "properties": {
          "health": {
            "type": "object",
            "title": "Health",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
              },
              "depletion": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Depletion",
                "default": 0,
                "maximum": 3,
                "minimum": 0,
                "description": "Accumulated damage, fatigue, strain, embarrassment, or exposure that remains when Maximum changes."
              }
            }
          },
          "decorum": {
            "type": "object",
            "title": "Decorum",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
              },
              "depletion": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Depletion",
                "default": 0,
                "maximum": 3,
                "minimum": 0,
                "description": "Accumulated damage, fatigue, strain, embarrassment, or exposure that remains when Maximum changes."
              }
            }
          },
          "composure": {
            "type": "object",
            "title": "Composure",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
              },
              "depletion": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Depletion",
                "default": 0,
                "maximum": 3,
                "minimum": 0,
                "description": "Accumulated damage, fatigue, strain, embarrassment, or exposure that remains when Maximum changes."
              }
            }
          },
          "concealment": {
            "type": "object",
            "title": "Concealment",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
              },
              "depletion": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Depletion",
                "default": 0,
                "maximum": 3,
                "minimum": 0,
                "description": "Accumulated damage, fatigue, strain, embarrassment, or exposure that remains when Maximum changes."
              }
            }
          },
          "wakefulness": {
            "type": "object",
            "title": "Wakefulness",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
              },
              "depletion": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Depletion",
                "default": 0,
                "maximum": 3,
                "minimum": 0,
                "description": "Accumulated damage, fatigue, strain, embarrassment, or exposure that remains when Maximum changes."
              }
            }
          }
        },
        "description": "Stored state for the five Condition Tracks. Missing values compute as Maximum 3 and Depletion 0.",
        "additionalProperties": false
      },
      "conditionTracks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "title": "Key"
            },
            "name": {
              "type": "string",
              "title": "Name"
            },
            "family": {
              "enum": [
                "persistent",
                "scene"
              ],
              "type": "string",
              "title": "Family"
            },
            "current": {
              "type": "number",
              "title": "Current"
            },
            "maximum": {
              "type": "number",
              "title": "Maximum"
            },
            "depletion": {
              "type": "number",
              "title": "Depletion"
            }
          }
        },
        "title": "Condition Tracks",
        "expression": "[{ key: 'health', name: 'Health', family: 'persistent', maximum: clamp($self.conditionState?.health?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.health?.depletion ?? 0, 0, 3) }, { key: 'wakefulness', name: 'Wakefulness', family: 'persistent', maximum: clamp($self.conditionState?.wakefulness?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.wakefulness?.depletion ?? 0, 0, 3) }, { key: 'composure', name: 'Composure', family: 'persistent', maximum: clamp($self.conditionState?.composure?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.composure?.depletion ?? 0, 0, 3) }, { key: 'decorum', name: 'Decorum', family: 'scene', maximum: clamp($self.conditionState?.decorum?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.decorum?.depletion ?? 0, 0, 3) }, { key: 'concealment', name: 'Concealment', family: 'scene', maximum: clamp($self.conditionState?.concealment?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.concealment?.depletion ?? 0, 0, 3) }].map(t => ({ key: t.key, name: t.name, family: t.family, maximum: t.maximum, depletion: t.depletion, current: clamp(t.maximum - t.depletion, 0, 3) }))",
        "description": "Derived Condition Tracks — five fixed rows (Health, Wakefulness, Composure, Decorum, Concealment). Current is always derived from Maximum and Depletion; it is never stored."
      }
    }
  },
  "layout": {
    "root": "page",
    "elements": {
      "name": {
        "type": "Heading",
        "props": {
          "text": {
            "$state": "/name"
