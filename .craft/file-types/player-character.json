              {
                "$state": "/attributes/hands"
              }
            ]
          ]
        },
        "children": []
      },
      "abilities-section": {
        "type": "Card",
        "props": {
          "title": "Trained Abilities"
        },
        "children": [
          "abilities-refs"
        ]
      },
      "archetypes-section": {
        "type": "Card",
        "props": {
          "title": "Archetypes"
        },
        "children": [
