{
  "fileTypeId": "019ff21e-97ce-70e0-8912-311103f24d50",
  "slug": "outfit-pattern",
  "name": "Outfit Pattern",
  "contentType": "json",
  "designation": null,
  "schemaHash": "14e475cd-a314-2743-7d28-efa6c865270f",
  "schema": {
    "type": "object",
    "required": [
      "name"
    ],
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "minLength": 1
      },
      "image": {
        "type": "object",
        "title": "Image",
        "format": "image",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "focalPoint": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              },
              "y": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              }
            }
          },
          "generation": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "generating",
                  "success",
                  "error"
                ],
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "finishedAt": {
                "type": "string"
              }
            }
          },
          "overlayUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "description": {
        "type": "string",
        "title": "Description",
        "format": "textarea"
      },
      "conditionModifiers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "track",
            "amount",
            "appliesBecause"
          ],
          "properties": {
            "track": {
              "enum": [
                "health",
                "energy",
                "nerve",
                "decorum",
                "cover"
              ],
              "type": "string",
              "title": "Track",
              "description": "The Condition Track this modifier applies to."
            },
            "amount": {
              "enum": [
                -3,
                -2,
                -1,
                0,
                1,
                2,
                3
              ],
              "type": "number",
              "title": "Amount",
              "maximum": 3,
              "minimum": -3,
              "description": "Signed change to the track's Effective Maximum."
            },
            "appliesBecause": {
              "type": "string",
              "title": "Why It Applies",
              "description": "A short player-facing explanation of why the outfit changes this Condition Track."
            }
          }
        },
        "title": "Condition Modifiers",
        "description": "Mechanical Condition Track modifiers that always apply while this outfit is worn. Each row changes the named track's effective maximum; appliesBecause explains the abstraction to the player."
      },
      "conditionModifierRows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "track": {
              "type": "string",
              "title": "Track"
            },
            "amount": {
              "type": "string",
              "title": "Amount"
            },
            "trackName": {
              "type": "string",
              "title": "Track Name"
            },
            "appliesBecause": {
              "type": "string",
              "title": "Why It Applies"
            }
          }
        },
        "title": "Condition Modifier Rows",
        "expression": "($self.conditionModifiers ?? []).map(m => ({ track: m.track, trackName: [{ key: 'health', name: 'Health' }, { key: 'energy', name: 'Energy' }, { key: 'nerve', name: 'Nerve' }, { key: 'decorum', name: 'Decorum' }, { key: 'cover', name: 'Cover' }].find(r => r.key === m.track)?.name ?? m.track, amount: `${m.amount > 0 ? '+' : ''}${m.amount}`, appliesBecause: m.appliesBecause }))",
        "description": "Player-facing rows derived from conditionModifiers for read-only display (track name, signed amount, and explanation)."
      }
    }
  },
  "layout": {
    "root": "page",
    "elements": {
      "hero": {
        "type": "ImageHeader",
        "props": {
          "src": {
            "$state": "/image"
          },
          "title": {
            "$state": "/name"
          },
          "aspectRatio": "square"
        },
        "children": []
      },
      "page": {
        "type": "Stack",
        "props": {
          "gap": "md",
          "direction": "vertical"
        },
        "children": [
          "hero",
          "description-card",
          "condition-card"
        ]
      },
      "modifier-row": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "children": [
          "modifier-heading",
          "modifier-applies"
        ]
      },
      "condition-card": {
        "type": "Card",
        "props": {
          "title": "Condition Modifiers"
        },
        "visible": {
          "$state": "/conditionModifiers"
        },
        "children": [
          "condition-modifiers-list"
        ]
      },
      "modifier-track": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "trackName"
          },
          "variant": "body"
        },
        "children": []
      },
      "modifier-amount": {
        "type": "Badge",
        "props": {
          "text": {
            "$item": "amount"
          },
          "variant": "secondary"
        },
        "children": []
      },
      "description-body": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/description"
          }
        },
        "children": []
      },
      "description-card": {
        "type": "Card",
        "props": {
          "title": "Description"
        },
        "visible": {
          "$state": "/description"
        },
        "children": [
          "description-body"
        ]
      },
      "modifier-applies": {
        "type": "Text",
        "props": {
          "text": {
            "$item": "appliesBecause"
          },
          "variant": "muted"
        },
        "children": []
      },
      "modifier-heading": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "align": "center",
          "direction": "horizontal"
        },
        "children": [
          "modifier-track",
          "modifier-amount"
        ]
      },
      "condition-modifiers-list": {
        "type": "Stack",
        "props": {
          "gap": "md",
          "direction": "vertical"
        },
        "repeat": {
          "key": "track",
          "statePath": "/conditionModifierRows"
        },
        "children": [
          "modifier-row"
        ]
      }
    }
  },
  "imageStyleInstructions": null,
  "showCoverImage": true,
  "creationFlow": null
}
