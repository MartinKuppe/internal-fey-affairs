    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "minLength": 1
      },
      "image": {
        "type": "object",
        "title": "Image",
        "format": "image",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "focalPoint": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              },
              "y": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              }
            }
          },
          "generation": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "generating",
                  "success",
                  "error"
                ],
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "finishedAt": {
                "type": "string"
              }
            }
          },
          "overlayUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "missions": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "mission"
        },
        "title": "Missions",
        "description": "Master list of all permanent Missions. Update whenever a permanent Mission is authored."
      },
      "description": {
        "type": "string",
        "title": "Description",
        "format": "textarea"
      },
      "currentMonth": {
        "enum": [
          "January",
          "February",
          "March",
          "April",
          "May",
          "June",
          "July",
          "August",
          "September",
          "October",
          "November",
          "December"
        ],
        "type": "string",
        "title": "Current Month",
        "description": "Runtime campaign calendar month."
      },
      "activeMissions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "title": "Image",
              "format": "image",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "focalPoint": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "maximum": 1,
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "maximum": 1,
                      "minimum": 0
                    }
                  }
                },
                "generation": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "generating",
                        "success",
                        "error"
                      ],
                      "type": "string"
                    },
                    "startedAt": {
                      "type": "string"
                    },
                    "finishedAt": {
                      "type": "string"
                    }
                  }
                },
                "overlayUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "status": {
              "type": "string"
            },
            "mission": {
              "type": "string",
              "referencedFileTypeSlug": "mission"
            },
            "description": {
              "type": "string"
            },
            "fixedDateLabel": {
              "type": "string"
            },
            "currentBeatObjective": {
              "type": "string"
            }
          }
        },
        "title": "Active Missions",
        "expression": "($self.missions ?? []).filter(m => load(m)?.status == \"active\").map(m => ({ mission: m, name: load(m)?.name ?? \"\", code: load(m)?.code ?? \"\", kind: load(m)?.kind ?? \"\", description: load(m)?.description ?? \"\", fixedDateLabel: load(m)?.fixedDateLabel ?? \"\", status: load(m)?.status ?? \"\", briefing: load(m)?.briefing ?? \"\", currentBeatObjective: load(m)?.currentBeatObjective ?? \"\", image: load(m)?.image ?? null }))",
        "description": "Computed projection of Missions whose stored status is active. Read-only; never stored."
      },
      "missionHistory": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "title": "Image",
              "format": "image",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "focalPoint": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "maximum": 1,
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "maximum": 1,
                      "minimum": 0
                    }
                  }
                },
                "generation": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "generating",
                        "success",
                        "error"
                      ],
                      "type": "string"
                    },
                    "startedAt": {
                      "type": "string"
                    },
                    "finishedAt": {
                      "type": "string"
                    }
                  }
                },
                "overlayUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "status": {
              "type": "string"
            },
            "mission": {
              "type": "string",
              "referencedFileTypeSlug": "mission"
            },
            "endedDateLabel": {
              "type": "string"
            }
          }
        },
        "title": "Mission History",
        "expression": "($self.missions ?? []).filter(m => [\"completed\", \"failed\", \"expired\"].includes(load(m)?.status)).map(m => ({ mission: m, name: load(m)?.name ?? \"\", code: load(m)?.code ?? \"\", kind: load(m)?.kind ?? \"\", description: load(m)?.description ?? \"\", status: load(m)?.status ?? \"\", endedDateLabel: load(m)?.endedDate ? ((load(m)?.endedDate?.month ?? \"\") + \" \" + (load(m)?.endedDate?.moonPhase ?? \"\")) : \"\", briefing: load(m)?.briefing?? \"\", image: load(m)?.image ?? null }))",
        "description": "Computed projection of completed, failed, and expired Missions, with terminal status and ended date where available. Read-only; never stored."
      },
      "startingMission": {
        "type": "string",
        "title": "Starting Mission",
        "description": "Authoritative campaign start. The single starting-Mission reference; Mission files carry no start flag.",
        "referencedFileTypeSlug": "mission"
      },
      "currentDateLabel": {
        "type": "string",
        "title": "Current Date (display)",
        "expression": "($self.currentMonth && $self.currentMoonPhase) ? ($self.currentMonth + \" \" + $self.currentMoonPhase) : \"\"",
        "description": "Computed display of the campaign date, e.g. November 🌒. Empty when the date has not yet been initialized. Never stored."
      },
      "currentMoonPhase": {
        "enum": [
          "🌑",
          "🌒",
          "🌓",
          "🌔",
          "🌕",
          "🌖",
          "🌗",
          "🌘"
        ],
        "type": "string",
        "title": "Current Moon Phase",
        "description": "Runtime campaign calendar moon phase."
      },
      "availableMissions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "image": {
              "type": "object",
