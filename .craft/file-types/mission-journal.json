                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "generating",
                        "success",
                        "error"
                      ],
                      "type": "string"
                    },
                    "startedAt": {
                      "type": "string"
                    },
                    "finishedAt": {
                      "type": "string"
                    }
                  }
                },
                "overlayUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "status": {
              "type": "string"
            },
            "mission": {
              "type": "string",
              "referencedFileTypeSlug": "mission"
            },
            "description": {
              "type": "string"
            },
            "fixedDateLabel": {
              "type": "string"
            }
          }
        },
        "title": "Known Upcoming Missions",
        "expression": "($self.missions ?? []).filter(m => (load(m)?.status == \"upcoming\") && (load(m)?.revealedToPlayer == true)).map(m => ({ mission: m, name: load(m)?.name ?? \"\", code: load(m)?.code ?? \"\", kind: load(m)?.kind ?? \"\", description: load(m)?.description ?? \"\", fixedDateLabel: load(m)?.fixedDateLabel ?? \"\", status: load(m)?.status ?? \"\", briefing: load(m)?.briefing?? \"\",image: load(m)?.image ?? null }))",
        "description": "Computed projection of upcoming Missions revealed to the player. Read-only; never stored."
      }
    }
  },
