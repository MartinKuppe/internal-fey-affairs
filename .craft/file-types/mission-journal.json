                    },
                    "status": {
                      "enum": [
                        "generating",
                        "success",
                        "error"
                      ],
                      "type": "string"
                    },
                    "startedAt": {
                      "type": "string"
                    },
                    "finishedAt": {
                      "type": "string"
                    }
                  }
                },
                "overlayUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "status": {
              "type": "string"
            },
            "mission": {
              "type": "string",
              "referencedFileTypeSlug": "mission"
            },
            "description": {
              "type": "string"
            },
            "fixedDateLabel": {
              "type": "string"
            }
          }
        },
        "title": "Available Missions",
        "expression": "($self.missions ?? []).filter(m => load(m)?.status == \"available\").map(m => ({ mission: m, name: load(m)?.name ?? \"\", code: load(m)?.code ?? \"\", kind: load(m)?.kind ?? \"\", description: load(m)?.description ?? \"\", fixedDateLabel: load(m)?.fixedDateLabel ?? \"\", status: load(m)?.status ?? \"\", briefing: load(m)?.briefing?? \"\", image: load(m)?.image ?? null }))",
        "description": "Computed projection of Missions whose stored status is available. Read-only; never stored."
      },
      "hasActiveMissions": {
        "type": "boolean",
        "title": "Has Active Missions",
        "expression": "($self.missions ?? []).filter(m => load(m)?.status == \"active\").length > 0",
        "description": "True when at least one Mission has stored status active. Read-only; for layout visibility."
      },
      "knownUpcomingMissions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "image": {
              "type": "object",
