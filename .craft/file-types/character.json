                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
              },
              "depletion": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Depletion",
                "default": 0,
                "maximum": 3,
                "minimum": 0,
                "description": "Accumulated damage, fatigue, strain, embarrassment, or exposure that remains when Maximum changes."
              }
            }
          },
          "decorum": {
            "type": "object",
            "title": "Decorum",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
              },
              "depletion": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Depletion",
                "default": 0,
                "maximum": 3,
                "minimum": 0,
                "description": "Accumulated damage, fatigue, strain, embarrassment, or exposure that remains when Maximum changes."
              }
            }
          },
          "composure": {
            "type": "object",
            "title": "Composure",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
              },
              "depletion": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Depletion",
                "default": 0,
                "maximum": 3,
                "minimum": 0,
                "description": "Accumulated damage, fatigue, strain, embarrassment, or exposure that remains when Maximum changes."
              }
            }
          },
          "concealment": {
            "type": "object",
            "title": "Concealment",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
              },
              "depletion": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Depletion",
                "default": 0,
                "maximum": 3,
                "minimum": 0,
                "description": "Accumulated damage, fatigue, strain, embarrassment, or exposure that remains when Maximum changes."
              }
            }
          },
          "wakefulness": {
            "type": "object",
            "title": "Wakefulness",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "type": "number",
                "title": "Maximum",
                "default": 3,
                "maximum": 3,
                "minimum": 0,
                "description": "The currently applicable Effective Maximum after outfit, environmental, and situational modifiers."
