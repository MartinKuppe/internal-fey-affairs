{
  "fileTypeId": "019fde04-450b-758c-a1f6-56a2945fdd47",
  "slug": "character",
  "name": "Character",
  "contentType": "json",
  "designation": "character",
  "category": "world",
  "schemaHash": "d66cc242-7d05-bd3e-2f38-e1e89bb7c576",
  "schema": {
    "type": "object",
    "required": [
      "name",
      "background"
    ],
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "minLength": 1
      },
      "image": {
        "type": "object",
        "title": "Image",
        "format": "image",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "focalPoint": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              },
              "y": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              }
            }
          },
          "generation": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "generating",
                  "success",
                  "error"
                ],
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "finishedAt": {
                "type": "string"
              }
            }
          },
          "overlayUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "level": {
        "type": "number",
        "title": "Level",
        "minimum": 1
      },
      "notes": {
        "type": "string",
        "title": "Notes",
        "format": "textarea"
      },
      "stats": {
        "type": "object",
        "title": "Ability Scores",
        "properties": {
          "wisdom": {
            "type": "number",
            "title": "Wisdom",
            "minimum": 1
          },
          "charisma": {
            "type": "number",
            "title": "Charisma",
            "minimum": 1
          },
          "strength": {
            "type": "number",
            "title": "Strength",
            "minimum": 1
          },
          "dexterity": {
            "type": "number",
            "title": "Dexterity",
            "minimum": 1
          },
          "constitution": {
            "type": "number",
            "title": "Constitution",
            "minimum": 1
          },
          "intelligence": {
            "type": "number",
            "title": "Intelligence",
            "minimum": 1
          }
        }
      },
      "ancestry": {
        "type": "string",
        "title": "Ancestry"
      },
      "inventory": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "equipment"
        },
        "title": "Inventory",
        "description": "Equipment files this character is carrying."
      },
      "background": {
        "type": "string",
        "title": "Background",
        "format": "textarea"
      },
      "description": {
        "type": "string",
        "title": "Description",
        "format": "textarea"
      },
      "personality": {
        "type": "string",
        "title": "Personality",
        "format": "textarea"
      },
      "characterClass": {
        "type": "string",
        "title": "Class",
        "description": "The character's adventuring class or broad archetype."
      },
      "carryingCapacity": {
        "type": "number",
        "title": "Carrying Capacity (lbs)",
        "expression": "($self.stats?.strength ?? 0) * 15"
      },
      "totalInventoryWeight": {
        "type": "number",
        "title": "Total Inventory Weight (lbs)",
        "expression": "sum($self.inventory ?? [], e => load(e)?.weight ?? 0)"
      }
    }
  },
  "layout": {
    "root": "page",
    "elements": {
      "hero": {
        "type": "ImageHeader",
        "props": {
          "src": {
            "$state": "/image"
          },
          "title": {
            "$state": "/name"
          },
          "subtitle": {
            "$state": "/characterClass"
          },
          "aspectRatio": "video"
        },
        "children": []
      },
      "page": {
        "type": "Stack",
        "props": {
          "gap": "md",
          "direction": "vertical"
        },
        "children": [
          "hero",
          "description-card",
          "overview-grid",
          "inventory-card",
          "background-section",
          "personality-section",
          "notes-section"
        ]
      },
      "stats": {
        "type": "StatGrid",
        "props": {
          "cols": 6,
          "items": [
            [
              "STR",
              {
                "$state": "/stats/strength"
              }
            ],
            [
              "DEX",
              {
                "$state": "/stats/dexterity"
              }
            ],
            [
              "CON",
              {
                "$state": "/stats/constitution"
              }
            ],
            [
              "INT",
              {
                "$state": "/stats/intelligence"
              }
            ],
            [
              "WIS",
              {
                "$state": "/stats/wisdom"
              }
            ],
            [
              "CHA",
              {
                "$state": "/stats/charisma"
              }
            ]
          ]
        },
        "children": []
      },
      "notes-body": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/notes"
          }
        },
        "children": []
      },
      "stats-card": {
        "type": "Card",
        "props": {
          "title": "Ability Scores"
        },
        "children": [
          "stats"
        ]
      },
      "basics-card": {
        "type": "Card",
        "props": {
          "title": "Basics"
        },
        "children": [
          "basics-list"
        ]
      },
      "basics-list": {
        "type": "FieldList",
        "props": {
          "items": [
            [
              "Class",
              {
                "$state": "/characterClass"
              }
            ],
            [
              "Level",
              {
                "$state": "/level"
              }
            ],
            [
              "Ancestry",
              {
                "$state": "/ancestry"
              }
            ]
          ]
        },
        "children": []
      },
      "notes-heading": {
        "type": "Heading",
        "props": {
          "text": "Notes",
          "level": "h3"
        },
        "children": []
      },
      "notes-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "visible": {
          "$state": "/notes"
        },
        "children": [
          "notes-heading",
          "notes-body"
        ]
      },
      "overview-grid": {
        "type": "Grid",
        "props": {
          "gap": "md",
          "columns": 2
        },
        "children": [
          "basics-card",
          "stats-card"
        ]
      },
      "inventory-card": {
        "type": "Card",
        "props": {
          "title": "Inventory"
        },
        "children": [
          "inventory-grid",
          "load-tracking-grid"
        ]
      },
      "inventory-grid": {
        "type": "FileReferenceGrid",
        "props": {
          "size": "md",
          "items": {
            "$state": "/inventory"
          },
          "label": null,
          "columns": 4,
          "fileTypeSlug": "equipment",
          "referenceField": null
        },
        "children": []
      },
      "background-body": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/background"
          }
        },
        "children": []
      },
      "description-body": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/description"
          }
        },
        "children": []
      },
      "description-card": {
        "type": "Card",
        "props": {
          "title": "Description"
        },
        "visible": {
          "$state": "/description"
        },
        "children": [
          "description-body"
        ]
      },
      "personality-body": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/personality"
          }
        },
        "children": []
      },
      "background-heading": {
        "type": "Heading",
        "props": {
          "text": "Background",
          "level": "h3"
        },
        "children": []
      },
      "background-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "visible": {
          "$state": "/background"
        },
        "children": [
          "background-heading",
          "background-body"
        ]
      },
      "load-tracking-grid": {
        "type": "StatGrid",
        "props": {
          "cols": 2,
          "items": [
            [
              "Carrying Capacity (lbs)",
              {
                "$state": "/carryingCapacity"
              }
            ],
            [
              "Total Weight (lbs)",
              {
                "$state": "/totalInventoryWeight"
              }
            ]
          ]
        },
        "children": []
      },
      "personality-heading": {
        "type": "Heading",
        "props": {
          "text": "Personality",
          "level": "h3"
        },
        "children": []
      },
      "personality-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "visible": {
          "$state": "/personality"
        },
        "children": [
          "personality-heading",
          "personality-body"
        ]
      }
    }
  },
  "imageStyleInstructions": null,
  "showCoverImage": true,
  "creationFlow": null
}
