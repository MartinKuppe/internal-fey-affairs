      },
      "outfit": {
        "type": "string",
        "title": "Outfit",
        "description": "The character's current worn outfit.",
        "referencedFileTypeSlug": "outfit"
      },
      "markers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "marker",
            "reason"
          ],
          "properties": {
            "marker": {
              "enum": [
                "Ungrateful",
                "Disrespectful",
                "Unsightly",
                "Violent",
                "Cruel",
                "Untrustworthy",
                "Oath-Breaker",
                "Generous",
                "Respectful",
                "Handsome",
                "Elegant",
                "Merciful",
                "Trustworthy",
