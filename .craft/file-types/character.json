              "title": "Marker"
            },
            "reason": {
              "type": "string",
              "title": "Reason"
            }
          }
        },
        "title": "Reputation Markers",
        "description": "Markers are visible to everyone — simply present or absent, each with the reason it was acquired."
      },
      "secrets": {
        "type": "string",
        "title": "Secrets",
        "format": "textarea",
        "description": "GM-facing hidden truth. Never reveal in player-facing narration."
      },
      "species": {
        "type": "string",
        "title": "Species",
        "description": "This character's species — Human or Fey in ordinary project metadata.",
        "referencedFileTypeSlug": "species"
      },
      "abilities": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "ability"
        },
        "title": "Trained Abilities",
        "description": "Start with your origin's three abilities. The GM may award additional abilities during play."
      },
      "archetypes": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "archetype"
        },
        "title": "Archetypes",
        "description": "Every applicable archetype — provenance, pattern, fey-role, profession, title, or social identity. Stored explicitly and flat; never inferred from indirect chains."
      },
      "attributes": {
        "type": "object",
        "title": "Attribute Dice",
        "properties": {
          "body": {
            "type": "number",
            "title": "Body",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "eyes": {
            "type": "number",
            "title": "Eyes",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "head": {
            "type": "number",
            "title": "Head",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "legs": {
            "type": "number",
            "title": "Legs",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "hands": {
            "type": "number",
            "title": "Hands",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "heart": {
            "type": "number",
            "title": "Heart",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "shadow": {
            "type": "number",
            "title": "Shadow",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          }
        },
        "description": "Each attribute is a dice pool of 1-5 d6s; every 4+ is a success. Your origin's attribute starts at 3, the rest at 2."
      },
      "background": {
        "type": "string",
        "title": "Background",
        "format": "textarea",
        "description": "Relevant history."
      },
      "description": {
        "type": "string",
        "title": "Description",
        "format": "textarea"
      },
      "graceLedger": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "currency",
            "amount",
            "day",
            "reason"
          ],
          "properties": {
            "day": {
              "type": "number",
              "title": "Day",
              "minimum": 1
            },
            "amount": {
              "type": "number",
              "title": "Amount",
              "description": "Signed balance change: positive credits the character, negative debits the character."
            },
            "reason": {
              "type": "string",
              "title": "Exact reason",
              "description": "Explains whether this entry was a payment, an exchange, a penalty, or a debt."
            },
            "currency": {
              "type": "string",
              "title": "Currency",
              "referencedFileTypeSlug": "grace"
            }
          }
        },
        "title": "Grace Ledger",
        "description": "Authoritative record of every Grace gain or loss. Balances are derived from this ledger — never maintain a separate running total. Negative amounts are Grace debt."
      },
      "personality": {
        "type": "string",
        "title": "Personality",
        "format": "textarea"
      },
      "conditionState": {
        "type": "object",
        "title": "Condition State",
        "properties": {
          "health": {
            "type": "object",
            "title": "Health",
            "properties": {
              "maximum": {
                "enum": [
                  0,
                  1,
                  2,
                  3
