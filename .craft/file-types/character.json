        "description": "Stored state for the five Condition Tracks. Optional — minor NPCs may omit it; missing values compute as Maximum 3 and Depletion 0.",
        "additionalProperties": false
      },
      "conditionTracks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "title": "Key"
            },
            "name": {
              "type": "string",
              "title": "Name"
            },
            "family": {
              "enum": [
                "persistent",
                "scene"
              ],
              "type": "string",
              "title": "Family"
            },
            "current": {
              "type": "number",
              "title": "Current"
            },
            "maximum": {
              "type": "number",
              "title": "Maximum"
            },
            "depletion": {
              "type": "number",
              "title": "Depletion"
            }
          }
        },
        "title": "Condition Tracks",
        "expression": "[{ key: 'health', name: 'Health', family: 'persistent', maximum: clamp($self.conditionState?.health?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.health?.depletion ?? 0, 0, 3) }, { key: 'wakefulness', name: 'Wakefulness', family: 'persistent', maximum: clamp($self.conditionState?.wakefulness?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.wakefulness?.depletion ?? 0, 0, 3) }, { key: 'composure', name: 'Composure', family: 'persistent', maximum: clamp($self.conditionState?.composure?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.composure?.depletion ?? 0, 0, 3) }, { key: 'decorum', name: 'Decorum', family: 'scene', maximum: clamp($self.conditionState?.decorum?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.decorum?.depletion ?? 0, 0, 3) }, { key: 'concealment', name: 'Concealment', family: 'scene', maximum: clamp($self.conditionState?.concealment?.maximum ?? 3, 0, 3), depletion: clamp($self.conditionState?.concealment?.depletion ?? 0, 0, 3) }].map(t => ({ key: t.key, name: t.name, family: t.family, maximum: t.maximum, depletion: t.depletion, current: clamp(t.maximum - t.depletion, 0, 3) }))",
        "description": "Derived Condition Tracks — five fixed rows (Health, Wakefulness, Composure, Decorum, Concealment). Current is always derived from Maximum and Depletion; it is never stored."
      }
