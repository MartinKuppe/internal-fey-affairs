{
  "fileTypeId": "019fde04-450b-758c-a1f6-56a2945fdd47",
  "slug": "character",
  "name": "Character",
  "contentType": "json",
  "designation": "character",
  "category": "world",
  "schemaHash": "6c547085-bedd-8ec2-d0ec-e7118fa51071",
  "schema": {
    "type": "object",
    "required": [
      "name",
      "origin"
    ],
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "minLength": 1
      },
      "image": {
        "type": "object",
        "title": "Image",
        "format": "image",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "focalPoint": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              },
              "y": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              }
            }
          },
          "generation": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "generating",
                  "success",
                  "error"
                ],
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "finishedAt": {
                "type": "string"
              }
            }
          },
          "overlayUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "notes": {
        "type": "string",
        "title": "Notes",
        "format": "textarea"
      },
      "origin": {
        "type": "string",
        "title": "Origin",
        "description": "This character's origin — their starting attribute and three trained abilities.",
        "referencedFileTypeSlug": "origin"
      },
      "markers": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "marker",
            "reason"
          ],
          "properties": {
            "marker": {
              "enum": [
                "Ungrateful",
                "Disrespectful",
                "Unsightly",
                "Violent",
                "Cruel",
                "Untrustworthy",
                "Oath-Breaker",
                "Generous",
                "Respectful",
                "Handsome",
                "Elegant",
                "Merciful",
                "Trustworthy",
                "Oath-Keeper"
              ],
              "type": "string",
              "title": "Marker"
            },
            "reason": {
              "type": "string",
              "title": "Reason"
            }
          }
        },
        "title": "Reputation Markers",
        "description": "Markers are visible to everyone — simply present or absent, each with the reason it was acquired."
      },
      "abilities": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "ability"
        },
        "title": "Trained Abilities",
        "description": "Start with your origin's three abilities. The GM may award additional abilities during play."
      },
      "inventory": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "equipment"
        },
        "title": "Inventory",
        "description": "Equipment files this character is carrying."
      },
      "attributes": {
        "type": "object",
        "title": "Attribute Dice",
        "properties": {
          "body": {
            "type": "number",
            "title": "Body",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "head": {
            "type": "number",
            "title": "Head",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "legs": {
            "type": "number",
            "title": "Legs",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "hands": {
            "type": "number",
            "title": "Hands",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "heart": {
            "type": "number",
            "title": "Heart",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "shadow": {
            "type": "number",
            "title": "Shadow",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          }
        },
        "description": "Each attribute is a dice pool of 1-5 d6s; every 4+ is a success. Your origin's attribute starts at 3, the rest at 2."
      },
      "description": {
        "type": "string",
        "title": "Description",
        "format": "textarea"
      },
      "graceLedger": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "currency",
            "amount",
            "day",
            "reason"
          ],
          "properties": {
            "day": {
              "type": "number",
              "title": "Day",
              "minimum": 1
            },
            "amount": {
              "type": "number",
              "title": "Amount",
              "description": "Signed balance change: positive credits the character, negative debits the character."
            },
            "reason": {
              "type": "string",
              "title": "Exact reason",
              "description": "Explains whether this entry was a payment, an exchange, a penalty, or a debt."
            },
            "currency": {
              "type": "string",
              "title": "Currency",
              "referencedFileTypeSlug": "grace"
            }
          }
        },
        "title": "Grace Ledger",
        "description": "Authoritative record of every Grace gain or loss. Balances are derived from this ledger — never maintain a separate running total. Negative amounts are Grace debt."
      },
      "personality": {
        "type": "string",
        "title": "Personality",
        "format": "textarea"
      }
    }
  },
