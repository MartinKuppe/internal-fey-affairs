{
  "fileTypeId": "019fde04-450b-758c-a1f6-56a2945fdd47",
  "slug": "character",
  "name": "Character",
  "contentType": "json",
  "designation": "character",
  "category": "world",
  "schemaHash": "b92b6d54-00a1-4cc3-2f1c-a5a3c40624f6",
  "schema": {
    "type": "object",
    "required": [
      "name",
      "origin"
    ],
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "minLength": 1
      },
      "image": {
        "type": "object",
        "title": "Image",
        "format": "image",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "focalPoint": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              },
              "y": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              }
            }
          },
          "generation": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "generating",
                  "success",
                  "error"
                ],
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "finishedAt": {
                "type": "string"
              }
            }
          },
          "overlayUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "notes": {
        "type": "string",
        "title": "Notes",
        "format": "textarea"
      },
      "origin": {
        "type": "string",
        "title": "Origin",
        "description": "This character's origin — their starting attribute and three trained abilities.",
        "referencedFileTypeSlug": "origin"
      },
      "abilities": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "ability"
        },
        "title": "Trained Abilities",
        "description": "Start with your origin's three abilities. The GM may award additional abilities during play."
      },
      "inventory": {
        "type": "array",
        "items": {
          "type": "string",
          "referencedFileTypeSlug": "equipment"
        },
        "title": "Inventory",
        "description": "Equipment files this character is carrying."
      },
      "attributes": {
        "type": "object",
        "title": "Attribute Dice",
        "properties": {
          "body": {
            "type": "number",
            "title": "Body",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "head": {
            "type": "number",
            "title": "Head",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "legs": {
            "type": "number",
            "title": "Legs",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "hands": {
            "type": "number",
            "title": "Hands",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "heart": {
            "type": "number",
            "title": "Heart",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          },
          "shadow": {
            "type": "number",
            "title": "Shadow",
            "default": 2,
            "maximum": 5,
            "minimum": 1
          }
        },
        "description": "Each attribute is a dice pool of 1-5 d6s; every 4+ is a success. Your origin's attribute starts at 3, the rest at 2."
      },
      "description": {
        "type": "string",
        "title": "Description",
        "format": "textarea"
      },
      "personality": {
        "type": "string",
        "title": "Personality",
        "format": "textarea"
      }
    }
  },
  "layout": {
    "root": "page",
    "elements": {
      "hero": {
        "type": "ImageHeader",
        "props": {
          "src": {
            "$state": "/image"
          },
          "title": {
            "$state": "/name"
          },
          "subtitle": {
            "$state": "/characterClass"
          },
          "aspectRatio": "video"
        },
        "children": []
      },
      "page": {
        "type": "Stack",
        "props": {
          "gap": "md",
          "direction": "vertical"
        },
        "children": [
          "hero",
          "description-card",
          "overview-grid",
          "inventory-card",
          "background-section",
          "personality-section",
          "notes-section",
          "origin-select",
          "attributes-section",
          "abilities-references"
        ]
      },
      "stats": {
        "type": "StatGrid",
        "props": {
          "cols": 6,
          "items": [
            [
              "STR",
              {
                "$state": "/stats/strength"
              }
            ],
            [
              "DEX",
              {
                "$state": "/stats/dexterity"
              }
            ],
            [
              "CON",
              {
                "$state": "/stats/constitution"
              }
            ],
            [
              "INT",
              {
                "$state": "/stats/intelligence"
              }
            ],
            [
              "WIS",
              {
                "$state": "/stats/wisdom"
              }
            ],
            [
              "CHA",
              {
                "$state": "/stats/charisma"
              }
            ]
          ]
        },
        "children": []
      },
      "notes-body": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/notes"
          }
        },
        "children": []
      },
      "stats-card": {
        "type": "Card",
        "props": {
          "title": "Ability Scores"
        },
        "children": [
          "stats"
        ]
      },
      "basics-card": {
        "type": "Card",
        "props": {
          "title": "Basics"
        },
        "children": [
          "basics-list"
        ]
      },
      "basics-list": {
        "type": "FieldList",
        "props": {
          "items": [
            [
              "Class",
              {
                "$state": "/characterClass"
              }
            ],
            [
              "Level",
              {
                "$state": "/level"
              }
            ],
            [
              "Ancestry",
              {
                "$state": "/ancestry"
              }
            ]
          ]
        },
        "children": []
      },
      "notes-heading": {
        "type": "Heading",
        "props": {
          "text": "Notes",
          "level": "h3"
        },
        "children": []
      },
      "notes-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "visible": {
          "$state": "/notes"
        },
        "children": [
          "notes-heading",
          "notes-body"
        ]
      },
      "origin-select": {
        "type": "Select",
        "props": {
          "label": "Origin",
          "value": {
            "$state": "/origin"
          },
          "options": null,
          "placeholder": null,
          "fileTypeSlug": "origin"
        },
        "visible": {
          "$state": "/origin"
        },
        "children": []
      },
      "overview-grid": {
        "type": "Grid",
        "props": {
          "gap": "md",
          "columns": 2
        },
        "children": [
          "basics-card",
          "stats-card"
        ]
      },
      "inventory-card": {
        "type": "Card",
        "props": {
          "title": "Inventory"
        },
        "children": [
          "inventory-grid",
          "load-tracking-grid"
        ]
      },
      "inventory-grid": {
        "type": "FileReferenceGrid",
        "props": {
          "size": "md",
          "items": {
            "$state": "/inventory"
          },
          "label": null,
          "columns": 4,
          "fileTypeSlug": "equipment",
          "referenceField": null
        },
        "children": []
      },
      "background-body": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/background"
          }
        },
        "children": []
      },
      "attributes-stats": {
        "type": "StatGrid",
        "props": {
          "cols": 2,
          "color": null,
          "items": {
            "$state": "/_attributesEntries"
          },
          "bgColor": null
        },
        "children": []
      },
      "description-body": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/description"
          }
        },
        "children": []
      },
      "description-card": {
        "type": "Card",
        "props": {
          "title": "Description"
        },
        "visible": {
          "$state": "/description"
        },
        "children": [
          "description-body"
        ]
      },
      "personality-body": {
        "type": "Markdown",
        "props": {
          "content": {
            "$state": "/personality"
          }
        },
        "children": []
      },
      "attributes-heading": {
        "type": "Heading",
        "props": {
          "text": "Attribute Dice",
          "level": "h3"
        },
        "children": []
      },
      "attributes-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "visible": {
          "$state": "/attributes"
        },
        "children": [
          "attributes-heading",
          "attributes-stats"
        ]
      },
      "background-heading": {
        "type": "Heading",
        "props": {
          "text": "Background",
          "level": "h3"
        },
        "children": []
      },
      "background-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "visible": {
          "$state": "/background"
        },
        "children": [
          "background-heading",
          "background-body"
        ]
      },
      "load-tracking-grid": {
        "type": "StatGrid",
        "props": {
          "cols": 2,
          "items": [
            [
              "Carrying Capacity (lbs)",
              {
                "$state": "/carryingCapacity"
              }
            ],
            [
              "Total Weight (lbs)",
              {
                "$state": "/totalInventoryWeight"
              }
            ]
          ]
        },
        "children": []
      },
      "personality-heading": {
        "type": "Heading",
        "props": {
          "text": "Personality",
          "level": "h3"
        },
        "children": []
      },
      "personality-section": {
        "type": "Stack",
        "props": {
          "gap": "sm",
          "direction": "vertical"
        },
        "visible": {
          "$state": "/personality"
        },
        "children": [
          "personality-heading",
          "personality-body"
        ]
      },
      "abilities-references": {
        "type": "FileReferenceGrid",
        "props": {
          "size": "md",
          "items": {
            "$state": "/abilities"
          },
          "label": "Trained Abilities",
          "columns": 4,
          "fileTypeSlug": "ability",
          "referenceField": null
        },
        "visible": {
          "$state": "/abilities"
        },
        "children": []
      }
    }
  },
  "imageStyleInstructions": null,
  "showCoverImage": true,
  "creationFlow": null
}
